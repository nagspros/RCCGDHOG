# Supabase Postgres is the default. Use the Session pooler URI from Supabase > Connect.
DHOG_DB_MODE=supabase
DATABASE_URL=
# MySQL 8+ alternative: set DHOG_DB_MODE=mysql and configure MYSQL_URL.
MYSQL_URL=
MYSQL_TLS=1
# MYSQL_SSL_CA=/absolute/path/to/mysql-ca.pem
# Local development without a remote database: set DHOG_DB_MODE=sqlite.
# DHOG_DATABASE=backend/data/church.sqlite3

# Turn on when served over HTTPS.
DHOG_SECURE_COOKIE=0
PUBLIC_SITE_URL=http://localhost:3000

# Leave blank until you are ready to send. Run the mail worker separately.
# Choose resend or smtp.
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=0

# Optional automatic discovery of embeddable broadcasts for the church's channel.
# Manual YouTube video links work without an API key.
YOUTUBE_CHANNEL_ID=UCbaf7qittz4vReSJfeJUiZA
YOUTUBE_API_KEY=
