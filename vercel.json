{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,src/data/legacyArchive.json}",
      "excludeFiles": "{public/**,dist/**,node_modules/**,backend/.venv/**,backend/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:section(about|ministries|programmes|programs|sermons|events|visit|prayer|ask-pastor|give|contact|connect|watch|gallery|admin)/:path*", "destination": "/index.html" }
  ]
}
